{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* 엄격하게 */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* verify.ts 와 smoke.tsx 는 node 로 실행하는 점검 스크립트라 앱 빌드에서 제외한다 */
  "exclude": ["src/core/search/verify.ts", "src/core/verifyData.ts", "src/core/verifyRegression.ts", "src/core/verifyClassify.ts", "src/core/verifyCluster.ts", "src/data/generate/**", "src/smoke.tsx", "src/gate.test.ts"]
}
